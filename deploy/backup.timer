[Unit]
Description=Dump the shared-auth database every night

[Timer]
# 03:30 Seoul like the apps, after the 03:00 Lightsail snapshot; dumps take turns through /run/lock/apps-backup.lock.
OnCalendar=*-*-* 03:30:00 Asia/Seoul
# Runs at the next boot when the server was off at that time.
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
