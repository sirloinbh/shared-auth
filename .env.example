# Copy to .env for local runs. Values tagged @ssm= come from AWS SSM on the server (ADR-0014).

# @desc Postgres password for the auth database. Generated on the server; never leaves it @required @secret @used=compose
POSTGRES_PASSWORD=

# @desc Public address of this service. Production: https://auth.daysofme.com @used=compose
BETTER_AUTH_URL=http://localhost:8110

# @desc Root domain whose subdomains share the session cookie @used=compose
ROOT_DOMAIN=daysofme.com

# @desc Signs session cookies and tokens. Generated once with `openssl rand -base64 32` @required @secret @used=compose @ssm=/sirloinbh/shared-auth/better-auth-secret
BETTER_AUTH_SECRET=

# @desc Emails allowed to sign in, comma-separated @required @secret @used=compose @ssm=/sirloinbh/shared-auth/allowed-emails
ALLOWED_EMAILS=

# @desc GitHub OAuth app client ID @required @secret @used=compose @ssm=/sirloinbh/shared-auth/github-client-id
GITHUB_CLIENT_ID=

# @desc GitHub OAuth app client secret @required @secret @used=compose @ssm=/sirloinbh/shared-auth/github-client-secret
GITHUB_CLIENT_SECRET=

# @desc Google OAuth client ID @required @secret @used=compose @ssm=/sirloinbh/shared-auth/google-client-id
GOOGLE_CLIENT_ID=

# @desc Google OAuth client secret @required @secret @used=compose @ssm=/sirloinbh/shared-auth/google-client-secret
GOOGLE_CLIENT_SECRET=
